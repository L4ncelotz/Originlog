{
  "name": "originlog",
  "version": "0.0.1",
  "description": "Know where a code change came from, and why.",
  "type": "module",
  "bin": {
    "originlog": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "provenance",
    "git",
    "origin",
    "code-history",
    "cli"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^9.5.2",
    "picocolors": "^1.1.1",
    "zod": "^4.5.4"
  },
  "overrides": {
    "esbuild": ">=0.28.1 <0.29.0"
  }
}
